{
  "name": "covercount",
  "version": "0.1.0",
  "description": "Banquet event order and catering production control for a hotel food and beverage department",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "covercount": "dist/src/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "bash scripts/check.sh",
    "check:pins": "node scripts/check-pins.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "map": "node scripts/generate-map.mjs",
    "map:check": "node scripts/generate-map.mjs --check",
    "docs": "npm run build && node scripts/generate-docs.mjs",
    "docs:check": "npm run build && node scripts/generate-docs.mjs --check",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "commander": "13.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.13.5",
    "@vitest/coverage-v8": "3.0.8",
    "eslint": "9.21.0",
    "prettier": "3.5.2",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.26.0",
    "vitest": "3.0.8"
  }
}
